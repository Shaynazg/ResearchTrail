# Copy this file to .env.local and fill in your own values.
# .env.local is ignored by Git, so the real values never reach GitHub.

# Password for the local database (used by docker-compose.yml)
DB_PASSWORD=choose-a-password

# Same password inside the connection string
DATABASE_URL=postgres://postgres:choose-a-password@localhost:5432/researchtrail

# Random string used to sign login cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=paste-a-long-random-string-here
